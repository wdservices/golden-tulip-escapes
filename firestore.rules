rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to all authenticated users for public data
    match /{document=**} {
      allow read: if request.auth != null;
    }
    
    // Feedback collection rules
    match /feedback/{feedbackId} {
      // Allow anyone to submit feedback
      allow create: if request.resource.data.keys().hasAll(['type', 'message']) &&
                    (request.resource.data.type == 'suggestion' || 
                     request.resource.data.type == 'complaint') &&
                    request.resource.data.message is string &&
                    request.resource.data.message.size() > 0 &&
                    request.resource.data.message.size() <= 2000;
    }
    
    // Sessions collection rules
    match /sessions/{sessionId} {
      // Allow users to create their own sessions
      allow create: if request.auth != null && 
                    request.auth.uid == request.resource.data.userId &&
                    request.resource.data.status == 'active';
      
      // Allow users to update only their own sessions
      allow update: if request.auth != null && 
                    request.auth.uid == resource.data.userId &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'logoutTime']);
      
      // Allow users to read their own sessions
      allow read: if request.auth != null && 
                  (request.auth.uid == resource.data.userId || 
                   (exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
                    get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true));
    }
    
    // Users collection rules
    match /users/{userId} {
      // Allow users to read their own profile
      // Allow HQ admins to read any profile
      // Allow branch admins to read profiles of users who have bookings in their branches
      allow read: if request.auth != null && 
                  (request.auth.uid == userId || 
                   isHQAdmin() || 
                   (isBranchAdmin() && userHasBookingInAdminBranch(userId)));
      
      // Allow users to update their own profile with limited fields
      // Allow HQ admins to update any profile
      // Allow branch admins to update profiles of users who have bookings in their branches
      allow update: if request.auth != null && 
                   (request.auth.uid == userId || 
                    isHQAdmin() || 
                    (isBranchAdmin() && userHasBookingInAdminBranch(userId))) &&
                   (isHQAdmin() || request.auth.uid == userId || 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'preferences', 'lastLogin', 'email', 'displayName', 'photoURL']));
      
      // Allow HQ admins to create user documents (for user management)
      allow create: if request.auth != null && isHQAdmin();
    }
    
    // Branches collection rules
    match /branches/{branchId} {
      // Allow read access to all authenticated users
      allow read: if request.auth != null;
      
      // Allow HQ admins to create, update, or delete any branch
      // Allow branch admins to update only branches they have access to
      allow create: if isHQAdmin();
      allow update: if isHQAdmin() || (isBranchAdmin() && hasBranchAccess(branchId));
      allow delete: if isHQAdmin();
      
      // Nested rooms collection
      match /rooms/{roomId} {
        // Allow read access to all authenticated users
        allow read: if request.auth != null;
        
        // Allow HQ admins to manage all rooms
        // Allow branch admins to manage rooms in branches they have access to
        allow create: if isHQAdmin() || (isBranchAdmin() && hasBranchAccess(branchId));
        allow update: if isHQAdmin() || (isBranchAdmin() && hasBranchAccess(branchId));
        allow delete: if isHQAdmin() || (isBranchAdmin() && hasBranchAccess(branchId));
      }
    }
    
    // Bookings collection rules
    match /bookings/{bookingId} {
      // Allow users to read their own bookings, branch admins to read bookings for their branches, and HQ admins to read all bookings
      allow read: if request.auth != null && 
                 (request.auth.uid == resource.data.userId || 
                  isHQAdmin() || 
                  (isBranchAdmin() && hasBranchAccess(resource.data.branchId)));
      
      // Allow authenticated users to create bookings, branch admins for their branches, and HQ admins for any branch
      allow create: if request.auth != null && 
                   (request.auth.uid == request.resource.data.userId || 
                    isHQAdmin() || 
                    (isBranchAdmin() && hasBranchAccess(request.resource.data.branchId)));
      
      // Allow users to update their own bookings, branch admins for their branches, and HQ admins for any booking
      allow update: if request.auth != null && 
                   (request.auth.uid == resource.data.userId || 
                    isHQAdmin() || 
                    (isBranchAdmin() && hasBranchAccess(resource.data.branchId)));
      
      // Allow users to delete their own bookings, branch admins for their branches, and HQ admins for any booking
      allow delete: if request.auth != null && 
                   (request.auth.uid == resource.data.userId || 
                    isHQAdmin() || 
                    (isBranchAdmin() && hasBranchAccess(resource.data.branchId)))
    }
    
    // Admin users collection rules
    match /adminUsers/{adminId} {
      // Allow users to read their own admin document to check admin status
      allow read: if request.auth != null && request.auth.uid == adminId;
      
      // Allow HQ admins to read all admin documents
      // Allow branch admins to read only their own admin document
      allow read: if request.auth != null && 
                  (isHQAdmin() || 
                   (isBranchAdmin() && request.auth.uid == adminId));
      
      // Allow only HQ admins to create, update, and delete admin users
      allow create, update, delete: if request.auth != null && isHQAdmin();
    }

    // Helper function to check if user is admin (legacy function for backward compatibility)
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true;
    }
    
    // Helper function to check if user is HQ admin
    function isHQAdmin() {
      return request.auth != null && 
             request.auth.token.role == 'hq-admin';
    }
    
    // Helper function to check if user is branch admin
    function isBranchAdmin() {
      return request.auth != null && 
             request.auth.token.role == 'branch-admin';
    }
    
    // Helper function to check if user has access to a specific branch
    function hasBranchAccess(branchId) {
      return request.auth != null && 
             (request.auth.token.branchIds.hasAny([branchId, 'all']) || 
              request.auth.token.role == 'hq-admin');
    }
    
    // Helper function to check if a user has bookings in branches that the admin has access to
    function userHasBookingInAdminBranch(userId) {
      // For branch admins, check if the user has any bookings in their branches
      // Simplified approach: if admin has 'all' access, allow access to all users
      // Otherwise, we'll need to implement a more specific check in the application logic
      return request.auth != null && 
             request.auth.token.role == 'branch-admin' &&
             (request.auth.token.branchIds.hasAny(['all']));
    }
  }
}
